<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants">

    <!-- Primary Web View -->
    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollbars="vertical|horizontal"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb_blue"
        android:scrollbarThumbHorizontal="@drawable/scrollbar_thumb_blue"
        android:scrollbarSize="6dp"
        android:scrollbarStyle="insideOverlay" />

    <!-- Top Loading Progress Indicator (Websafe Material Blue) -->
    <ProgressBar
        android:id="@+id/page_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3.5dp"
        android:layout_gravity="top"
        android:progressTint="@color/scrollbar_blue"
        android:indeterminateTint="@color/scrollbar_blue"
        android:progressBackgroundTint="@color/progress_bg"
        android:visibility="gone" />

    <!-- Debug Grid & Crosshair Coordinate Overlay (60px x 60px) -->
    <com.cathode.browser.DebugGridView
        android:id="@+id/debug_grid_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="6dp"
        android:visibility="gone" />

    <!-- Bookmarks Drawer (2-Row Scalable Grid, Floats Directly Above Bottom Bar) -->
    <LinearLayout
        android:id="@+id/bookmarks_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="100dp"
        android:background="@drawable/bar_background"
        android:elevation="14dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Row 1 -->
                <LinearLayout
                    android:id="@+id/bookmarks_row1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <!-- Row 2 -->
                <LinearLayout
                    android:id="@+id/bookmarks_row2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Sleek Bottom Navigation Bar (Centered, Auto-Hides on Inactivity) -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="30dp"
        android:background="@drawable/bar_background"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <!-- Exit App Button (Completely Rounded Circle) -->
        <ImageButton
            android:id="@+id/btn_exit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_circle_selector"
            android:contentDescription="Exit"
            android:focusable="true"
            android:nextFocusRight="@+id/btn_back"
            android:scaleType="center"
            android:src="@drawable/ic_nav_exit" />

        <!-- Back Button (Completely Rounded Circle) -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_circle_selector"
            android:contentDescription="Back"
            android:focusable="true"
            android:nextFocusLeft="@+id/btn_exit"
            android:nextFocusRight="@+id/btn_forward"
            android:scaleType="center"
            android:src="@drawable/ic_nav_back" />

        <!-- Forward Button (Completely Rounded Circle) -->
        <ImageButton
            android:id="@+id/btn_forward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_circle_selector"
            android:contentDescription="Forward"
            android:focusable="true"
            android:nextFocusLeft="@+id/btn_back"
            android:nextFocusRight="@+id/btn_refresh"
            android:scaleType="center"
            android:src="@drawable/ic_nav_forward" />

        <!-- Refresh Button with Clean Vector SVG -->
        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_circle_selector"
            android:contentDescription="Reload"
            android:focusable="true"
            android:nextFocusLeft="@+id/btn_forward"
            android:nextFocusRight="@+id/url_edit"
            android:scaleType="center"
            android:src="@drawable/ic_nav_refresh" />

        <!-- Search / URL Input Container (Completely Rounded Pill with Embedded Clear X Button) -->
        <FrameLayout
            android:id="@+id/search_container"
            android:layout_width="480dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/url_edit_selector">

            <EditText
                android:id="@+id/url_edit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:focusable="true"
                android:gravity="center_vertical|start"
                android:hint="@string/search_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:nextFocusLeft="@+id/btn_refresh"
                android:nextFocusRight="@+id/btn_clear"
                android:paddingStart="16dp"
                android:paddingEnd="44dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_clear"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_clear_selector"
                android:contentDescription="Clear"
                android:focusable="true"
                android:nextFocusLeft="@+id/url_edit"
                android:nextFocusRight="@+id/btn_go"
                android:scaleType="center"
                android:src="@drawable/ic_nav_clear" />
        </FrameLayout>

        <!-- Go / Navigate Button (Completely Rounded Circle) -->
        <ImageButton
            android:id="@+id/btn_go"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_circle_selector"
            android:contentDescription="Go"
            android:focusable="true"
            android:nextFocusLeft="@+id/btn_clear"
            android:nextFocusRight="@+id/btn_bookmarks"
            android:scaleType="center"
            android:src="@drawable/ic_nav_go" />

        <!-- Bookmarks Button (Completely Rounded Pill with Red Shortcut Indicator) -->
        <Button
            android:id="@+id/btn_bookmarks"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_pill_selector"
            android:drawableStart="@drawable/dot_red"
            android:drawablePadding="8dp"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:nextFocusLeft="@+id/btn_go"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Bookmarks"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Floating HUD Mode Indicator Toast -->
    <TextView
        android:id="@+id/hud_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="30dp"
        android:background="@drawable/hud_background"
        android:elevation="20dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="Notification"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Performance & Diagnostics Debug HUD Panel (Snapped to 60px Grid) -->
    <LinearLayout
        android:id="@+id/debug_hud_panel"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/debug_card_background"
        android:elevation="150dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <!-- Header: Title & FPS Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_launcher"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CATHODE DIAGNOSTICS"
                android:textColor="@color/scrollbar_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/debug_text_fps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_fps_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="60 FPS"
                android:textColor="@color/status_success"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/divider_subtle" />

        <!-- Section 1: SYSTEM & NETWORK -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM &amp; NETWORK"
            android:textColor="@color/scrollbar_blue"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/debug_text_memory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="RAM: 4 MB | Load: 450 ms"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/debug_text_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="NET: Wi-Fi (1048 Mbps)"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/divider_subtle" />

        <!-- Section 2: VIEWPORT & DOCUMENT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIEWPORT &amp; DOCUMENT"
            android:textColor="@color/scrollbar_blue"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/debug_text_viewport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="VIEW: 960x540 | Screen: 1920x1080 (320dpi)"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/debug_text_doc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="DOC: 960x1080 | Scroll: (0, 0) | Zoom: 1.0"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/divider_subtle" />

        <!-- Section 3: NAVIGATION & CURSOR -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NAVIGATION &amp; CURSOR"
            android:textColor="@color/scrollbar_blue"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/debug_text_cursor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="CURSOR: (960, 540) | Mode: Content | Step: 20px"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Hardware-Accelerated Virtual Cursor View (60px x 60px) -->
    <ImageView
        android:id="@+id/virtual_cursor"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:elevation="180dp"
        android:src="@drawable/cursor_pointer"
        android:visibility="visible" />

    <!-- Bookmark Edit/Delete Modal Dialog (TV-Optimized) -->
    <FrameLayout
        android:id="@+id/bookmark_dialog_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/modal_scrim"
        android:elevation="200dp"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/bookmark_dialog_card"
            android:layout_width="540dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bar_background"
            android:elevation="210dp"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="20dp"
            android:paddingEnd="30dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/text_bookmark_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Bookmark"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Name"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/edit_bookmark_title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/url_edit_selector"
                    android:paddingStart="14dp"
                    android:paddingEnd="42dp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:imeOptions="actionNext"
                    android:nextFocusRight="@+id/btn_bookmark_clear_title"
                    android:nextFocusDown="@+id/edit_bookmark_url"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btn_bookmark_clear_title"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_clear_selector"
                    android:contentDescription="Clear title"
                    android:focusable="true"
                    android:scaleType="center"
                    android:src="@drawable/ic_nav_clear"
                    android:nextFocusLeft="@+id/edit_bookmark_title"
                    android:nextFocusDown="@+id/btn_bookmark_clear_url" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="URL"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/edit_bookmark_url"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/url_edit_selector"
                    android:paddingStart="14dp"
                    android:paddingEnd="42dp"
                    android:singleLine="true"
                    android:inputType="textUri"
                    android:imeOptions="actionDone"
                    android:nextFocusUp="@+id/edit_bookmark_title"
                    android:nextFocusRight="@+id/btn_bookmark_clear_url"
                    android:nextFocusDown="@+id/btn_bookmark_save"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btn_bookmark_clear_url"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_clear_selector"
                    android:contentDescription="Clear URL"
                    android:focusable="true"
                    android:scaleType="center"
                    android:src="@drawable/ic_nav_clear"
                    android:nextFocusLeft="@+id/edit_bookmark_url"
                    android:nextFocusUp="@+id/btn_bookmark_clear_title"
                    android:nextFocusDown="@+id/btn_bookmark_save" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_bookmark_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_delete_selector"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Delete"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:nextFocusUp="@+id/edit_bookmark_url"
                    android:nextFocusRight="@+id/btn_bookmark_cancel"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btn_bookmark_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/btn_pill_selector"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Cancel"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:nextFocusUp="@+id/edit_bookmark_url"
                    android:nextFocusLeft="@+id/btn_bookmark_delete"
                    android:nextFocusRight="@+id/btn_bookmark_save"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btn_bookmark_save"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/btn_save_selector"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Save"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:nextFocusUp="@+id/edit_bookmark_url"
                    android:nextFocusLeft="@+id/btn_bookmark_cancel"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Exit Confirmation Modal Dialog (TV-Optimized) -->
    <FrameLayout
        android:id="@+id/exit_dialog_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/modal_scrim"
        android:elevation="200dp"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bar_background"
            android:elevation="210dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="30dp"
            android:paddingEnd="30dp"
            android:paddingBottom="30dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_launcher"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Exit Cathode?"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Do you want to close the browser?"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_exit_confirm"
                    android:layout_width="120dp"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_pill_selector"
                    android:text="Exit"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:nextFocusRight="@+id/btn_exit_cancel"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btn_exit_cancel"
                    android:layout_width="120dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/btn_pill_selector"
                    android:text="Cancel"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:nextFocusLeft="@+id/btn_exit_confirm"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
