<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer black ring shadow for contrast on white sites -->
    <item>
        <shape android:shape="oval">
            <size android:width="26dp" android:height="26dp" />
            <stroke android:width="3dp" android:color="#99000000" />
        </shape>
    </item>
    <!-- Sharp white ring -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
    <!-- Center drop shadow for contrast on white sites -->
    <item android:top="11dp" android:left="11dp" android:right="9dp" android:bottom="9dp">
        <shape android:shape="oval">
            <solid android:color="#99000000" />
        </shape>
    </item>
    <!-- Center white pinpoint dot -->
    <item android:top="10dp" android:left="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
