<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer black ring shadow for contrast on white sites (60px x 60px) -->
    <item>
        <shape android:shape="oval">
            <size android:width="30dp" android:height="30dp" />
            <stroke android:width="3dp" android:color="#99000000" />
        </shape>
    </item>
    <!-- Sharp white ring -->
    <item android:top="2.5dp" android:left="2.5dp" android:right="2.5dp" android:bottom="2.5dp">
        <shape android:shape="oval">
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
    <!-- High-contrast down arrow (perfectly centered) -->
    <item
        android:top="7dp"
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp"
        android:drawable="@drawable/ic_arrow_down_reticle" />
</layer-list>
